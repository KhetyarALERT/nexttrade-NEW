export default function AutoTradeSettings({ language = "en" }) {
  const labels = t[language] || t.en;
  const isRTL = language === "ar";

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [dirty, setDirty] = useState(false);
  const [panelOpen, setPanelOpen] = useState(false);
  const [advancedOpen, setAdvancedOpen] = useState(false);

  const [settings, setSettings] = useState({
    auto_enabled: false,
    mode: "FIXED_MARGIN",
    fixed_margin_usdt: 10,
    risk_percent_equity: 1,
    leverage_mode: "FOLLOW_SIGNAL_CAP",
    fixed_leverage: 5,
    max_leverage: 10,
    max_margin_per_trade_usdt: 25,
    max_open_positions_total: 5,
    signal_expiry_seconds: 180,
    max_entry_deviation_percent: 0.3
  });

  useEffect(() => {
    loadSettings();
  }, []);

  const loadSettings = async () => {
    try {
      const res = await base44.functions.invoke("copyTradingUser", { action: "getSettings" });
      if (res.data?.ok && res.data.data) {
        setSettings((prev) => ({ ...prev, ...res.data.data }));
      }
    } catch (e) {
      console.error("Failed to load settings:", e);
    } finally {
      setLoading(false);
    }
  };

  const update = (changes) => {
    setSettings((prev) => ({ ...prev, ...changes }));
    setDirty(true);
  };

  const applyPreset = (key) => {
    update(PRESETS[key]);
  };

  const handleToggle = async (enabled) => {
    update({ auto_enabled: enabled });
    setSaving(true);
    try {
      const updatedSettings = { ...settings, auto_enabled: enabled };
      const res = await base44.functions.invoke("copyTradingUser", { action: "saveSettings", settings: updatedSettings });
      if (res.data?.ok) {
        toast.success(enabled ?
          (language === "ar" ? "التداول التلقائي مفعّل" : "Auto-Trade enabled") :
          (language === "ar" ? "التداول التلقائي متوقف" : "Auto-Trade disabled")
        );
        setDirty(false);
        setSettings(updatedSettings);
      } else {
        throw new Error(res.data?.error?.message || "Save failed");
      }
    } catch (e) {
      toast.error(e.message);
      update({ auto_enabled: !enabled });
    } finally {
      setSaving(false);
    }
  };

  const handleSave = async () => {
    setSaving(true);
    try {
      if (settings.mode === "FIXED_MARGIN" && settings.fixed_margin_usdt < 1) {
        throw new Error(language === "ar" ? "الحد الأدنى 1 USDT" : "Minimum is 1 USDT");
      }
      const res = await base44.functions.invoke("copyTradingUser", { action: "saveSettings", settings });
      if (res.data?.ok) {
        toast.success(labels.saved);
        setDirty(false);
      } else {
        throw new Error(res.data?.error?.message || "Save failed");
      }
    } catch (e) {
      toast.error(e.message);
    } finally {
      setSaving(false);
    }
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center py-8">
        <div className="relative">
          <Loader2 className="w-6 h-6 animate-spin text-primary" />
          <div className="absolute inset-0 blur-sm bg-primary/20 animate-pulse rounded-full" />
        </div>
      </div>
    );
  }

  const activePreset = Object.entries(PRESETS).find(([, v]) =>
    v.fixed_margin_usdt === settings.fixed_margin_usdt &&
    v.max_leverage === settings.max_leverage &&
    v.max_open_positions_total === settings.max_open_positions_total
  )?.[0] || null;

  return (
    <div dir={isRTL ? "rtl" : "ltr"} className="w-full max-w-md mx-auto">
      <Collapsible open={panelOpen} onOpenChange={setPanelOpen} className="group">
        <div className={cn(
          "rounded-2xl border transition-all duration-500 overflow-hidden",
          settings.auto_enabled ?
            "border-primary/20 bg-gradient-to-b from-primary/[0.04] to-transparent shadow-lg shadow-primary/5" :
            "border-border/40 bg-card/40 backdrop-blur-sm"
        )}>
          {/* Header Section */}
          <div className="p-4 flex items-center justify-between gap-4">
            <div className="flex items-center gap-3.5 min-w-0 flex-1">
              <div className={cn(
                "w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 transition-all duration-500",
                settings.auto_enabled ?
                  "bg-primary text-primary-foreground shadow-lg shadow-primary/25 scale-105" :
                  "bg-muted/50 text-muted-foreground"
              )}>
                {settings.auto_enabled ? <Zap className="w-5 h-5 fill-current" /> : <ZapOff className="w-5 h-5" />}
              </div>
              <div className="min-w-0 flex-1">
                <div className="flex items-center gap-2">
                  <span className="text-sm font-bold text-foreground tracking-tight">{labels.autoTrade}</span>
                  <Badge variant="outline" className={cn(
                    "text-[9px] px-1.5 py-0 h-4 font-bold uppercase tracking-wider border-none",
                    settings.auto_enabled ? "bg-emerald-500/10 text-emerald-500" : "bg-muted/50 text-muted-foreground"
                  )}>
                    {settings.auto_enabled ? labels.activeStatus : labels.inactiveStatus}
                  </Badge>
                </div>
                <p className="text-[11px] text-muted-foreground mt-0.5 line-clamp-1 opacity-80">
                  {settings.auto_enabled 
                    ? `${settings.fixed_margin_usdt} USDT · ${settings.max_leverage}x · ${settings.max_open_positions_total} ${labels.trades}`
                    : labels.autoTradeDesc
                  }
                </p>
              </div>
            </div>

            <div className="flex items-center gap-3 flex-shrink-0">
              <Switch
                checked={settings.auto_enabled}
                onCheckedChange={handleToggle}
                disabled={saving}
                className={cn(
                  "data-[state=checked]:bg-primary shadow-sm",
                  saving && "opacity-50"
                )}
              />
              <CollapsibleTrigger asChild>
                <button
                  type="button"
                  className={cn(
                    "w-8 h-8 rounded-full flex items-center justify-center transition-all duration-300",
                    "text-muted-foreground hover:text-foreground hover:bg-muted/80",
                    panelOpen && "bg-muted/80 text-foreground rotate-180"
                  )}>
                  <ChevronDown className="w-4 h-4" />
                </button>
              </CollapsibleTrigger>
            </div>
          </div>

          {/* Settings Content */}
          <CollapsibleContent className="data-[state=closed]:animate-collapse-up data-[state=open]:animate-collapse-down">
            <div className="px-4 pb-5 pt-2 space-y-6 border-t border-border/20">
              
              {/* Risk Presets */}
              <div className="space-y-3">
                <div className="flex items-center justify-between">
                  <div>
                    <h4 className="text-[11px] font-bold text-foreground uppercase tracking-widest">{labels.riskProfile}</h4>
                    <p className="text-[10px] text-muted-foreground">{labels.riskProfileDesc}</p>
                  </div>
                </div>
                <div className="grid grid-cols-3 gap-2.5">
                  {["low", "mid", "high"].map((key) => {
                    const PresetIcon = key === "low" ? Shield : key === "mid" ? Scale : TrendingUp;
                    const isActive = activePreset === key;
                    const colors = {
                      low: "hover:border-blue-500/30 hover:bg-blue-500/5",
                      mid: "hover:border-amber-500/30 hover:bg-amber-500/5",
                      high: "hover:border-rose-500/30 hover:bg-rose-500/5"
                    };
                    return (
                      <button
                        key={key}
                        onClick={() => applyPreset(key)}
                        className={cn(
                          "relative p-3 rounded-xl text-center transition-all duration-300 border group/btn",
                          isActive ?
                            "border-primary bg-primary/5 ring-1 ring-primary/10 shadow-sm" :
                            cn("border-border/40 bg-card/20", colors[key])
                        )}>
                        <div className={cn(
                          "w-8 h-8 rounded-lg mx-auto mb-2 flex items-center justify-center transition-colors",
                          isActive ? "bg-primary text-primary-foreground" : "bg-muted/50 text-muted-foreground group-hover/btn:text-foreground"
                        )}>
                          <PresetIcon className="w-4 h-4" />
                        </div>
                        <span className={cn("block text-[11px] font-bold", isActive ? "text-primary" : "text-foreground/70")}>
                          {labels[key]}
                        </span>
                        <div className="mt-1 flex items-center justify-center gap-1 opacity-60">
                          <span className="text-[9px] font-mono">{PRESETS[key].fixed_margin_usdt}$</span>
                          <span className="text-[8px]">•</span>
                          <span className="text-[9px] font-mono">{PRESETS[key].max_leverage}x</span>
                        </div>
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* Main Controls */}
              <div className="space-y-5">
                {/* Amount Per Trade */}
                <div className="space-y-3">
                  <div className="flex items-center justify-between">
                    <div className="flex items-center gap-2">
                      <div className="w-6 h-6 rounded-md bg-primary/10 flex items-center justify-center">
                        <DollarSign className="w-3.5 h-3.5 text-primary" />
                      </div>
                      <span className="text-xs font-bold text-foreground">{labels.amountPerTrade}</span>
                      <HelpButton content={labels.amountPerTradeDesc} />
                    </div>
                    <div className="flex items-center gap-2 bg-muted/30 rounded-lg px-2 py-1 border border-border/20">
                      <input
                        type="number"
                        value={settings.fixed_margin_usdt}
                        onChange={(e) => update({ fixed_margin_usdt: Math.max(1, Number(e.target.value) || 1) })}
                        className="bg-transparent w-12 text-xs font-mono font-bold text-right focus:outline-none"
                        min={1}
                      />
                      <span className="text-[10px] font-bold text-muted-foreground">USDT</span>
                    </div>
                  </div>
                  <Slider
                    value={[settings.fixed_margin_usdt]}
                    min={1}
                    max={100}
                    step={1}
                    onValueChange={([v]) => update({ fixed_margin_usdt: v })}
                    className="py-2"
                  />
                </div>

                {/* Leverage & Max Trades Grid */}
                <div className="grid grid-cols-2 gap-4">
                  <div className="space-y-3 p-3.5 rounded-2xl bg-muted/20 border border-border/20">
                    <div className="flex items-center justify-between">
                      <div className="flex items-center gap-1.5">
                        <Activity className="w-3 h-3 text-primary/70" />
                        <span className="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">{labels.maxLeverage}</span>
                      </div>
                      <HelpButton content={labels.leverageHelp} side="top" />
                    </div>
                    <div className="flex items-baseline gap-1 justify-center py-1">
                      <span className="text-2xl font-mono font-black text-foreground">{settings.max_leverage}</span>
                      <span className="text-xs font-bold text-muted-foreground">x</span>
                    </div>
                    <Slider
                      value={[settings.max_leverage]}
                      min={1}
                      max={20}
                      step={1}
                      onValueChange={([v]) => update({ max_leverage: v })}
                    />
                  </div>

                  <div className="space-y-3 p-3.5 rounded-2xl bg-muted/20 border border-border/20">
                    <div className="flex items-center gap-1.5">
                      <Target className="w-3 h-3 text-primary/70" />
                      <span className="text-[10px] font-bold text-muted-foreground uppercase tracking-wider">{labels.maxOpenTrades}</span>
                    </div>
                    <div className="flex items-baseline gap-1 justify-center py-1">
                      <span className="text-2xl font-mono font-black text-foreground">{settings.max_open_positions_total}</span>
                      <span className="text-[10px] font-bold text-muted-foreground uppercase">{labels.trades}</span>
                    </div>
                    <Slider
                      value={[settings.max_open_positions_total]}
                      min={1}
                      max={10}
                      step={1}
                      onValueChange={([v]) => update({ max_open_positions_total: v })}
                    />
                  </div>
                </div>
              </div>

              {/* Safety Limit */}
              <div className="relative group/safety">
                <div className="absolute -inset-0.5 bg-gradient-to-r from-emerald-500/20 to-primary/20 rounded-2xl blur opacity-30 group-hover/safety:opacity-50 transition duration-500" />
                <div className="relative flex items-center justify-between rounded-2xl border border-emerald-500/20 bg-emerald-500/[0.02] p-4">
                  <div className="flex items-center gap-3">
                    <div className="w-8 h-8 rounded-full bg-emerald-500/10 flex items-center justify-center">
                      <ShieldCheck className="w-4 h-4 text-emerald-500" />
                    </div>
                    <div>
                      <span className="text-xs font-bold text-foreground block">{labels.maxPerTrade}</span>
                      <span className="text-[10px] text-muted-foreground">Absolute safety cap</span>
                    </div>
                  </div>
                  <div className="flex items-center gap-2 bg-background/50 rounded-xl px-3 py-1.5 border border-emerald-500/10">
                    <input
                      type="number"
                      value={settings.max_margin_per_trade_usdt}
                      onChange={(e) => update({ max_margin_per_trade_usdt: Math.max(1, Number(e.target.value) || 1) })}
                      className="bg-transparent w-12 text-xs font-mono font-bold text-right focus:outline-none"
                      min={1}
                    />
                    <span className="text-[10px] font-bold text-emerald-500/70">USDT</span>
                  </div>
                </div>
              </div>

              {/* Estimated Outcome Preview */}
              <div className="space-y-2">
                <div className="flex items-center gap-2 px-1">
                  <ArrowUpRight className="w-3 h-3 text-primary" />
                  <span className="text-[10px] font-bold text-muted-foreground uppercase tracking-widest">{labels.estimatedOutcome}</span>
                </div>
                <EstimatedOutcome
                  amount={settings.fixed_margin_usdt}
                  leverage={settings.max_leverage}
                  maxPerTrade={settings.max_margin_per_trade_usdt}
                  language={language}
                />
              </div>

              {/* Advanced Settings */}
              <Collapsible open={advancedOpen} onOpenChange={setAdvancedOpen} className="pt-2">
                <CollapsibleTrigger asChild>
                  <button
                    type="button"
                    className="w-full flex items-center justify-between px-4 py-3 rounded-xl bg-muted/10 hover:bg-muted/20 transition-colors group/adv"
                  >
                    <div className="flex items-center gap-2.5">
                      <Settings2 className="w-4 h-4 text-muted-foreground group-hover/adv:text-primary transition-colors" />
                      <span className="text-[11px] font-bold text-muted-foreground group-hover/adv:text-foreground transition-colors uppercase tracking-wider">
                        {labels.showAdvanced}
                      </span>
                    </div>
                    <ChevronDown className={cn("w-4 h-4 text-muted-foreground transition-transform duration-300", advancedOpen && "rotate-180")} />
                  </button>
                </CollapsibleTrigger>
                <CollapsibleContent className="pt-4 px-1">
                  <div className="grid grid-cols-2 gap-4">
                    <div className="space-y-2">
                      <div className="flex items-center gap-1.5">
                        <Clock className="w-3 h-3 text-muted-foreground" />
                        <label className="text-[10px] font-bold text-muted-foreground uppercase tracking-tight">
                          {labels.signalExpiry} (s)
                        </label>
                      </div>
                      <Input
                        type="number"
                        value={settings.signal_expiry_seconds}
                        onChange={(e) => update({ signal_expiry_seconds: Number(e.target.value) || 180 })}
                        className="h-9 font-mono text-xs bg-muted/20 border-border/40 rounded-xl focus:ring-primary/20"
                        inputMode="numeric"
                      />
                    </div>
                    <div className="space-y-2">
                      <div className="flex items-center gap-1.5">
                        <AlertCircle className="w-3 h-3 text-muted-foreground" />
                        <label className="text-[10px] font-bold text-muted-foreground uppercase tracking-tight">
                          {labels.priceDeviation} %
                        </label>
                      </div>
                      <Input
                        type="number"
                        value={settings.max_entry_deviation_percent}
                        onChange={(e) => update({ max_entry_deviation_percent: Number(e.target.value) || 0.3 })}
                        className="h-9 font-mono text-xs bg-muted/20 border-border/40 rounded-xl focus:ring-primary/20"
                        step="0.1"
                        inputMode="decimal"
                      />
                    </div>
                  </div>
                </CollapsibleContent>
              </Collapsible>

              {/* Save Button */}
              <div className={cn(
                "transition-all duration-500 overflow-hidden",
                dirty ? "max-h-20 opacity-100 mt-4" : "max-h-0 opacity-0"
              )}>
                <Button
                  onClick={handleSave}
                  disabled={saving}
                  className="w-full h-11 rounded-xl text-xs font-bold bg-primary hover:bg-primary/90 text-primary-foreground shadow-lg shadow-primary/20 transition-all active:scale-[0.98]"
                >
                  {saving ? (
                    <Loader2 className="w-4 h-4 animate-spin ltr:mr-2 rtl:ml-2" />
                  ) : (
                    <Save className="w-4 h-4 ltr:mr-2 rtl:ml-2" />
                  )}
                  {saving ? labels.saving : labels.save}
                </Button>
              </div>
            </div>
          </CollapsibleContent>
        </div>
      </Collapsible>
      
      <style dangerouslySetInnerHTML={{ __html: `
        @keyframes collapse-down {
          from { height: 0; opacity: 0; }
          to { height: var(--radix-collapsible-content-height); opacity: 1; }
        }
        @keyframes collapse-up {
          from { height: var(--radix-collapsible-content-height); opacity: 1; }
          to { height: 0; opacity: 0; }
        }
        .animate-collapse-down {
          animation: collapse-down 0.3s ease-out;
        }
        .animate-collapse-up {
          animation: collapse-up 0.3s ease-out;
        }
      `}} />
